        ],
        "type": "object"
      },
      "name": "results"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Search CNKI: query (research question, planned into subject/title/keyword channels), concept_groups (AND of synonym OR-groups) or expression (field search: authors, source, funds...). Reads the best candidates' details and journal quality, adds a keyword feedback round, ranks. Returns search_id, counts, plan, coverage, columnar rows.",
      "inputSchema": {
        "$defs": {
          "expression": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "enum": [
                  "subject",
                  "title",
                  "keywords",
                  "abstract",
                  "authors",
                  "first_author",
                  "corresponding_author",
                  "institutions",
                  "source",
                  "doi",
                  "funds",
                  "fulltext",
                  "references",
                  "classification",
                  "subtitle",
                  "title_keywords_abstract"
                ],
                "type": "string"
              },
              "items": {
                "items": {
                  "$ref": "#/$defs/expression"
                },
                "type": "array"
              },
              "match": {
                "enum": [
                  "phrase",
                  "exact"
                ],
                "type": "string"
              },
              "op": {
                "enum": [
                  "and",
                  "or",
                  "not"
                ],
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "concept_groups": {
            "description": "AND of synonym OR-groups, e.g. [[\"违约金\",\"违约赔偿\"],[\"调整\"]]",
            "items": {
              "items": {
                "type": "string"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "type": [
              "null",
              "array"
            ]
          },
          "expression": {
            "$ref": "#/$defs/expression",
            "description": "native field search instead of query",
            "type": [
              "null",
              "object"
            ]
          },
          "limit": {
            "description": "rows shown, default 10, max 50",
            "type": "integer"
          },
          "mode": {
            "description": "default balanced; precise skips the feedback round",
            "enum": [
              "precise",
              "balanced",
              "broad"
            ],
            "type": "string"
          },
          "options": {
            "additionalProperties": false,
            "properties": {
              "candidate_target": {
                "description": "default 300",
                "type": "integer"
              },
              "max_pages": {
                "description": "pages per channel, default 5",
                "type": "integer"
              },
              "max_requests": {
                "description": "request budget, default 600",
                "type": "integer"
              },
              "metadata": {
                "description": "default ranked: detail pages of the best candidates only",
                "enum": [
                  "ranked",
                  "all",
                  "basic"
                ],
                "type": "string"
              },
              "on_verification": {
                "description": "default ask: window for the user",
                "enum": [
                  "ask",
                  "skip"
                ],
                "type": "string"
              },
              "timeout_seconds": {
                "description": "active-time budget, default 900",
                "type": "integer"
              }
            },
            "type": [
              "null",
              "object"
            ]
          },
          "query": {
            "description": "research question or keywords",
            "type": "string"
          },
          "refresh": {
            "description": "ignore the 10-minute cache",
            "type": "boolean"
          },
          "sort": {
            "description": "default relevance",
            "enum": [
              "relevance",
              "date_desc",
              "cited_desc",
              "downloaded_desc"
            ],
            "type": "string"
          },
          "view": {
            "enum": [
              "compact",
              "titles",
              "full"
            ],
            "type": "string"
          },
          "year_from": {
            "type": "integer"
          },
          "year_to": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "search"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "No args: login and service state. operation_id: wait (default 50 s) for the result; also cancel, user_done, show, recover.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cancel": {
            "type": "boolean"
          },
          "check_login": {
            "description": "check the login on a background page",
            "type": "boolean"
          },
          "details": {
            "description": "local diagnostics",
            "type": "boolean"
          },
          "operation_id": {
            "type": "string"
          },
          "recover": {
            "description": "restart the browser",
            "type": "boolean"
          },
          "show": {
            "description": "bring the verification window to the front",
            "type": "boolean"
          },
          "user_done": {
            "description": "manual step finished (institutional remote login)",
            "type": "boolean"
          },
          "wait_seconds": {
            "description": "1-55, default 50",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "status"
    }
  ]
}
