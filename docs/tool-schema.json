    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Read a paper's HTML full text, 8000 chars per call; continue with snapshot_id + offset=next_offset (no network). First page lists sections. Earlier complete readings are reused. trial=true: preview only.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "max_characters": {
            "description": "default 8000, max 30000",
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "on_verification": {
            "enum": [
              "ask",
              "skip"
            ],
            "type": "string"
          },
          "record_ref": {
            "type": "string"
          },
          "refresh": {
            "description": "reopen the reader instead of the saved text",
            "type": "boolean"
          },
          "section": {
            "description": "only this section (a title from sections)",
            "type": "string"
          },
          "snapshot_id": {
            "description": "continue saved text without network",
            "type": "string"
          },
          "title": {
            "description": "exact full title instead of record_ref",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "read"
    },
    {
      "annotations": {
