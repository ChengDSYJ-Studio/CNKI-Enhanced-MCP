      "description": "Page a saved search locally; continue=true resumes a partial search.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "additional_requests": {
            "description": "default 200",
            "type": "integer"
          },
          "continue": {
            "description": "resume a partial search",
            "type": "boolean"
          },
          "limit": {
            "description": "default 10, max 100",
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "scope": {
            "description": "default selected",
            "enum": [
              "selected",
              "eligible",
              "candidates"
