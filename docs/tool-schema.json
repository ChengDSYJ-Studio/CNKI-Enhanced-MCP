  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Download the PDF/CAJ into data/downloads/, only when the user wants the file. An unknown outcome is never clicked again without retry=true.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "filename": {
            "description": "a basename; never overwrites",
            "type": "string"
          },
          "format": {
            "description": "default auto (PDF first)",
            "enum": [
              "auto",
              "pdf",
              "caj"
            ],
            "type": "string"
          },
          "on_verification": {
            "enum": [
              "ask",
              "skip"
            ],
            "type": "string"
          },
          "record_ref": {
            "type": "string"
          },
          "retry": {
            "description": "click again after an unknown outcome",
            "type": "boolean"
          },
          "subdirectory": {
            "description": "folder under data/downloads/",
            "type": "string"
          },
          "title": {
            "description": "exact full title instead of record_ref",
            "type": "string"
          },
          "wait_seconds": {
            "description": "default 120",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "download"
    },
